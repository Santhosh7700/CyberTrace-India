# CyberTrace-India Backend Environment Configuration
# Copy this file to .env and fill in actual values for your local environment.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cybertrace_india
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# CORS Configuration (Frontend Development Origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT Configuration (Generate a strong Base64-encoded 256-bit+ secret)
JWT_SECRET=replace_with_a_strong_base64_encoded_secret_at_least_32_bytes
JWT_EXPIRATION_MS=86400000
